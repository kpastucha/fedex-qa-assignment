{
  "name": "fdx-assignment",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "clean": "rimraf dist coverage .angular",
    "test": "ng test",
    "test:coverage": "npm test -- --code-coverage",
    "test:coverage:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:install": "npx playwright install --with-deps",
    "test:e2e:update": "npx playwright test --grep '@visual' --update-snapshots",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "tsc:check": "tsc --noEmit",
    "pre-commit": "npm run format:fix && npm run lint:fix && npm run tsc:check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "16.0.0",
    "@angular/common": "16.0.0",
    "@angular/compiler": "16.0.0",
    "@angular/core": "16.0.0",
    "@angular/forms": "16.0.0",
    "@angular/platform-browser": "16.0.0",
    "@angular/platform-browser-dynamic": "16.0.0",
    "@angular/router": "16.0.0",
    "@axe-core/playwright": "4.11.1",
    "bootstrap": "^5.3.0",
    "http-status-codes": "^2.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.5.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "16.0.0",
    "@angular-eslint/builder": "16.0.0",
    "@angular-eslint/eslint-plugin": "16.0.0",
    "@angular-eslint/eslint-plugin-template": "16.0.0",
    "@angular-eslint/schematics": "16.0.0",
    "@angular-eslint/template-parser": "16.0.0",
    "@angular/cli": "16.0.0",
    "@angular/compiler-cli": "16.0.0",
    "@angular/language-service": "16.0.0",
    "@playwright/test": "1.58.2",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.10.0",
    "@typescript-eslint/eslint-plugin": "5.59.2",
    "@typescript-eslint/parser": "5.59.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "5.0.4"
  }
}
